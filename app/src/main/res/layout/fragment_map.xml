<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_beige">
    <include
        android:id="@+id/headerLayout"
        layout="@layout/header_common"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:id="@+id/mapContent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent">
        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
        <ScrollView
            android:id="@+id/mapEmptyScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/emptyStateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_32"
                android:visibility="gone">
                <ProgressBar
                    android:id="@+id/mapLoadingIndicator"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginBottom="@dimen/space_16"
                    android:contentDescription="@string/map_loading"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/tvMapStateIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    android:text="🗺️"
                    android:textSize="48sp" />
                <TextView
                    android:id="@+id/tvMapStateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"
                    android:text="@string/map_empty_title"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvMapStateMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/map_empty_message"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:id="@+id/mapControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_margin="@dimen/screen_gutter">
            <LinearLayout
                android:id="@+id/mapZoomControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginEnd="@dimen/space_8">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnZoomIn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/map_zoom_in_content_description"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="@string/map_zoom_in"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/background_card"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/text_primary"
                    app:strokeWidth="2dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnZoomOut"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="@dimen/space_4"
                    android:contentDescription="@string/map_zoom_out_content_description"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="@string/map_zoom_out"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/background_card"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/text_primary"
                    app:strokeWidth="2dp" />
            </LinearLayout>
            <TextView
                android:id="@+id/tvOsmAttribution"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/background_map_attribution"
                android:clickable="true"
                android:contentDescription="@string/osm_attribution_content_description"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingHorizontal="@dimen/space_12"
                android:paddingVertical="@dimen/space_8"
                android:text="@string/osm_attribution"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
